backend/alembic/versions/__pycache__/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
frontend/dist/
.vite/
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── ML models (large binaries — store in object storage, not git) ─────────────
backend/models/*.pkl
backend/models/*.joblib

# ── Generated reports / uploads ───────────────────────────────────────────────
backend/reports/
backend/uploads/
