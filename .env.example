# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-to-a-256-bit-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database (matches docker-compose.yml defaults) ────────────────────────────
DATABASE_URL=postgresql+asyncpg://xproject:xproject@db:5432/xproject

# ── Redis (matches docker-compose.yml defaults) ───────────────────────────────
REDIS_URL=redis://redis:6379

# ── POS — Slesh NFC wristband API ─────────────────────────────────────────────
SLESH_API_URL=https://api.slesh.io/v1
SLESH_API_KEY=

# ── AI (Anthropic Claude — for chat assistant and report narrative) ────────────
ANTHROPIC_API_KEY=
